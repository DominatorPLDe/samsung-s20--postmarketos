+			#phy-cells = <1>;
+			status = "okay";
+		};
+		tmu_cpu: tmu@10090000 {
+			compatible = "samsung,exynos990-tmu";
+			reg = <0x10090000 0x800>;
+			interrupts = <GIC_SPI 478 IRQ_TYPE_LEVEL_HIGH>;
