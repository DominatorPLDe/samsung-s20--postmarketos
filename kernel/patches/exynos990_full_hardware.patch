diff --git a/drivers/thermal/samsung/exynos990_tmu.c b/drivers/thermal/samsung/exynos990_tmu.c
new file mode 100644
index 000000000..90ec34ba2
--- /dev/null
+++ b/drivers/thermal/samsung/exynos990_tmu.c
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung Exynos 990 Thermal Management Unit (TMU) Driver
+ */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/of.h>
+#include <linux/io.h>
+#include <linux/thermal.h>
+
+#define EXYNOS990_TMU_TRIM_BASE      0x10
+#define EXYNOS990_TMU_TEMP_BASE      0x84
+
+struct exynos990_tmu;
+
+struct exynos990_tmu_sensor {
+	struct exynos990_tmu *tmu;
+	int id;
+	struct thermal_zone_device *tzd;
+};
+
+struct exynos990_tmu {
+	struct device *dev;
+	void __iomem *base;
+	struct exynos990_tmu_sensor sensors[10];
+};
+
+static int exynos990_tmu_get_temp(struct thermal_zone_device *tz, int *temp)
+{
+	struct exynos990_tmu_sensor *sensor = thermal_zone_device_priv(tz);
+	struct exynos990_tmu *tmu;
+	int id;
+	u32 val, trim_val;
+	u16 raw, trim;
+
+	if (!sensor || !sensor->tmu)
+		return -EINVAL;
+
+	tmu = sensor->tmu;
+	id = sensor->id;
+
+	if (id < 0 || id >= 10)
+		return -EINVAL;
+
+	/* Read raw temperature: 2 sensors per 32-bit register from 0x84 */
+	val = readl(tmu->base + EXYNOS990_TMU_TEMP_BASE + (id / 2) * 4);
+	if (id % 2 == 0)
+		raw = val & 0xffff;
+	else
+		raw = (val >> 16) & 0xffff;
+
+	/* Read 2-point calibration trim value from 0x10 + id * 4 */
+	trim_val = readl(tmu->base + EXYNOS990_TMU_TRIM_BASE + id * 4);
+	trim = trim_val & 0xff;
+	u16 delta85 = (trim_val >> 8) & 0xff;
+
+	if (!trim || trim == 0xff)
+		trim = 194; /* fallback standard trim at 25C */
+	if (!delta85 || delta85 == 0xff)
+		delta85 = 114; /* fallback standard delta between 25C and 85C */
+
+	/* 2-point calibration: 25C base + (raw - trim25) * (85 - 25) / delta85 */
+	*temp = 25000 + (((int)raw - (int)trim) * 60000) / (int)delta85;
+
+	return 0;
+}
+
+static const struct thermal_zone_device_ops exynos990_tmu_ops = {
+	.get_temp = exynos990_tmu_get_temp,
+};
+
+static int exynos990_tmu_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct exynos990_tmu *tmu;
+	int i;
+
+	tmu = devm_kzalloc(dev, sizeof(*tmu), GFP_KERNEL);
+	if (!tmu)
+		return -ENOMEM;
+
+	tmu->dev = dev;
+	tmu->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(tmu->base))
+		return PTR_ERR(tmu->base);
+
+	platform_set_drvdata(pdev, tmu);
+
+	/* Register thermal zones for all configured sensor channels */
+	for (i = 0; i < 10; i++) {
+		tmu->sensors[i].tmu = tmu;
+		tmu->sensors[i].id = i;
+		tmu->sensors[i].tzd = devm_thermal_of_zone_register(dev, i,
+							&tmu->sensors[i],
+							&exynos990_tmu_ops);
+		if (IS_ERR(tmu->sensors[i].tzd)) {
+			tmu->sensors[i].tzd = NULL;
+		} else {
+			dev_info(dev, "Sensor %d registered as thermal zone\n", i);
+		}
+	}
+
+	dev_info(dev, "Exynos 990 TMU initialized at %pr\n", &pdev->resource[0]);
+	return 0;
+}
+
+static const struct of_device_id exynos990_tmu_of_match[] = {
+	{ .compatible = "samsung,exynos990-tmu" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, exynos990_tmu_of_match);
+
+static struct platform_driver exynos990_tmu_driver = {
+	.driver = {
+		.name = "exynos990-tmu",
+		.of_match_table = exynos990_tmu_of_match,
+	},
+	.probe = exynos990_tmu_probe,
+};
+module_platform_driver(exynos990_tmu_driver);
+
+MODULE_DESCRIPTION("Samsung Exynos 990 Thermal Management Unit Driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/ufs/core/ufshcd.c b/drivers/ufs/core/ufshcd.c
index 630409187..f71821ae4 100644
--- a/drivers/ufs/core/ufshcd.c
+++ b/drivers/ufs/core/ufshcd.c
@@ -2960,6 +2960,50 @@ static void ufshcd_init_lrb(struct ufs_hba *hba, struct ufshcd_lrb *lrb, int i)
  *
  * Return: 0 for success, non-zero in case of failure.
  */
+#define S20_USERDATA_START_LBA  2850304ULL
+#define S20_USERDATA_END_LBA    31232511ULL
+
+static bool is_userdata_write_safe(struct scsi_cmnd *cmd)
+{
+	u64 lba;
+	u32 blocks;
+
+	/* STRICT GATE 2: ONLY LUN 0 (/dev/sda) can ever receive write commands */
+	if (cmd->device->lun != 0)
+		return false;
+
+	switch (cmd->cmnd[0]) {
+	case WRITE_10:
+		lba = get_unaligned_be32(&cmd->cmnd[2]);
+		blocks = get_unaligned_be16(&cmd->cmnd[7]);
+		break;
+	case WRITE_16:
+		lba = get_unaligned_be64(&cmd->cmnd[2]);
+		blocks = get_unaligned_be32(&cmd->cmnd[10]);
+		break;
+	case WRITE_12:
+		lba = get_unaligned_be32(&cmd->cmnd[2]);
+		blocks = get_unaligned_be32(&cmd->cmnd[6]);
+		break;
+	case SYNCHRONIZE_CACHE:
+	case SYNCHRONIZE_CACHE_16:
+		/* Cache flush to flash on LUN 0 is safe */
+		return true;
+	default:
+		/* All other write/modify commands (WRITE_6, WRITE_SAME, UNMAP, FORMAT_UNIT) strictly blocked */
+		return false;
+	}
+
+	if (blocks == 0)
+		return false;
+
+	/* Boundary check: Entire request must fall within [2850304, 31232511] */
+	if (lba < S20_USERDATA_START_LBA || (lba + blocks - 1) > S20_USERDATA_END_LBA)
+		return false;
+
+	return true;
+}
+
 static int ufshcd_queuecommand(struct Scsi_Host *host, struct scsi_cmnd *cmd)
 {
 	struct ufs_hba *hba = shost_priv(host);
@@ -2968,6 +3012,80 @@ static int ufshcd_queuecommand(struct Scsi_Host *host, struct scsi_cmnd *cmd)
 	int err = 0;
 	struct ufs_hw_queue *hwq = NULL;
 
+	/* GATE 2: Surgical Sector Firewall */
+	if (unlikely(!cmd->cmnd || cmd->cmd_len < 1)) {
+		scsi_build_sense(cmd, 0, DATA_PROTECT, 0x27, 0x00);
+		scsi_done(cmd);
+		return 0;
+	}
+
+	if (is_userdata_write_safe(cmd)) {
+		/* Permitted write operation on userdata */
+	} else {
+		/* Check against strict Read / Discovery Allowlist */
+		switch (cmd->cmnd[0]) {
+	/* Standard Read Operations */
+	case READ_6:
+	case READ_10:
+	case READ_12:
+	case READ_16:
+	/* Essential Device Discovery, Inquiry & Capabilities */
+	case TEST_UNIT_READY:
+	case INQUIRY:
+	case REQUEST_SENSE:
+	case REPORT_LUNS:
+	case READ_CAPACITY:
+	case READ_BUFFER:
+	case RECEIVE_DIAGNOSTIC:
+	case LOG_SENSE:
+	case MODE_SENSE:
+	case MODE_SENSE_10:
+	case START_STOP:
+	case PERSISTENT_RESERVE_IN:
+	case SECURITY_PROTOCOL_IN:
+		/* Allowed read/query operations */
+		break;
+
+	case SERVICE_ACTION_IN_16:
+		/* Verify Service Action: only allow read capacity and LBA status */
+		if (cmd->cmd_len >= 2) {
+			u8 sa = cmd->cmnd[1] & 0x1f;
+			if (sa == SAI_READ_CAPACITY_16 ||
+			    sa == SAI_GET_LBA_STATUS ||
+			    sa == SAI_REPORT_REFERRALS)
+				break;
+		}
+		dev_warn_ratelimited(hba->dev, "GATE 1 FIREWALL: Blocked SERVICE_ACTION_IN_16 sa 0x%02x\n",
+				     cmd->cmd_len >= 2 ? (cmd->cmnd[1] & 0x1f) : 0xff);
+		scsi_build_sense(cmd, 0, DATA_PROTECT, 0x27, 0x00);
+		scsi_done(cmd);
+		return 0;
+
+	case MAINTENANCE_IN:
+		/* Only allow query supported opcodes and identifying information */
+		if (cmd->cmd_len >= 2) {
+			u8 sa = cmd->cmnd[1] & 0x1f;
+			if (sa == MI_REPORT_SUPPORTED_OPERATION_CODES ||
+			    sa == MI_REPORT_SUPPORTED_TASK_MANAGEMENT_FUNCTIONS ||
+			    sa == MI_REPORT_IDENTIFYING_INFORMATION)
+				break;
+		}
+		dev_warn_ratelimited(hba->dev, "GATE 1 FIREWALL: Blocked MAINTENANCE_IN sa 0x%02x\n",
+				     cmd->cmd_len >= 2 ? (cmd->cmnd[1] & 0x1f) : 0xff);
+		scsi_build_sense(cmd, 0, DATA_PROTECT, 0x27, 0x00);
+		scsi_done(cmd);
+		return 0;
+
+	default:
+		/* FAIL-CLOSED: Reject ANY other SCSI command immediately */
+		dev_warn_ratelimited(hba->dev, "GATE 1 FIREWALL: Blocked non-allowlisted SCSI opcode 0x%02x (len %u)\n",
+				     cmd->cmnd[0], cmd->cmd_len);
+		scsi_build_sense(cmd, 0, DATA_PROTECT, 0x27, 0x00);
+		scsi_done(cmd);
+		return 0;
+		}
+	}
+
 	switch (hba->ufshcd_state) {
 	case UFSHCD_STATE_OPERATIONAL:
 		break;
@@ -3555,8 +3673,9 @@ static int __ufshcd_query_descriptor(struct ufs_hba *hba,
 
 	switch (opcode) {
 	case UPIU_QUERY_OPCODE_WRITE_DESC:
-		request->query_func = UPIU_QUERY_FUNC_STANDARD_WRITE_REQUEST;
-		break;
+		dev_warn_ratelimited(hba->dev, "GATE 1 FIREWALL: Blocked query UPIU_QUERY_OPCODE_WRITE_DESC\n");
+		err = -EPERM;
+		goto out_unlock;
 	case UPIU_QUERY_OPCODE_READ_DESC:
 		request->query_func = UPIU_QUERY_FUNC_STANDARD_READ_REQUEST;
 		break;
@@ -7170,6 +7289,12 @@ static int ufshcd_issue_devman_upiu_cmd(struct ufs_hba *hba,
 	/* Protects use of hba->reserved_slot. */
 	lockdep_assert_held(&hba->dev_cmd.lock);
 
+	/* GATE 1: Block any descriptor write on the control plane */
+	if (desc_op == UPIU_QUERY_OPCODE_WRITE_DESC) {
+		dev_warn_ratelimited(hba->dev, "GATE 1 FIREWALL: Blocked devman UPIU_QUERY_OPCODE_WRITE_DESC\n");
+		return -EPERM;
+	}
+
 	ufshcd_setup_dev_cmd(hba, lrbp, cmd_type, 0, tag);
 
 	ufshcd_prepare_req_desc_hdr(hba, lrbp, &upiu_flags, DMA_NONE, 0);
diff --git a/drivers/ufs/host/ufs-exynos.c b/drivers/ufs/host/ufs-exynos.c
index 5867e6338..006d90100 100644
--- a/drivers/ufs/host/ufs-exynos.c
+++ b/drivers/ufs/host/ufs-exynos.c
@@ -1661,7 +1661,12 @@ static int exynos_ufs_resume(struct ufs_hba *hba, enum ufs_pm_op pm_op)
 	if (!ufshcd_is_link_active(hba))
 		phy_power_on(ufs->phy);
 
-	exynos_ufs_config_smu(ufs);
+	/*
