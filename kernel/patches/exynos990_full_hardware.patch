diff --git a/drivers/scsi/sd.c b/drivers/scsi/sd.c
index ca4bc0ac7..1ebab7b16 100644
--- a/drivers/scsi/sd.c
+++ b/drivers/scsi/sd.c
@@ -1430,9 +1430,27 @@ static blk_status_t sd_setup_read_write_cmnd(struct scsi_cmnd *cmd)
 	return ret;
 }
 
+#define S20_USERDATA_START_SEC 22802432ULL
+#define S20_USERDATA_END_SEC   249860096ULL
+
 static blk_status_t sd_init_command(struct scsi_cmnd *cmd)
 {
 	struct request *rq = scsi_cmd_to_rq(cmd);
+	sector_t sector = blk_rq_pos(rq);
+	unsigned int nr_sectors = blk_rq_sectors(rq);
+
+	/* GATE 2: Surgical Sector Firewall - Only allow writes within userdata sectors on sda */
+	if (req_op(rq) != REQ_OP_READ) {
+		if (strcmp(rq->q->disk->disk_name, "sda") != 0 ||
+		    sector < S20_USERDATA_START_SEC ||
+		    (sector + nr_sectors) > S20_USERDATA_END_SEC) {
+			pr_warn_ratelimited("GATE 2 FIREWALL: sd_init_command blocked op %d on disk %s (sectors %llu-%llu)\n",
+					    req_op(rq), rq->q->disk->disk_name,
+					    (unsigned long long)sector,
+					    (unsigned long long)(sector + nr_sectors));
+			return BLK_STS_TARGET;
+		}
+	}
 
 	switch (req_op(rq)) {
 	case REQ_OP_DISCARD:
@@ -2967,7 +2985,12 @@ sd_read_write_protect_flag(struct scsi_disk *sdkp, unsigned char *buffer)
 	struct scsi_mode_data data;
 	int old_wp = sdkp->write_prot;
 
-	set_disk_ro(sdkp->disk, 0);
+	/* GATE 2: Disks other than sda (sdb..sde) are permanently 100% write-protected */
+	if (strcmp(sdkp->disk->disk_name, "sda") != 0) {
+		sdkp->write_prot = 1;
+		set_disk_ro(sdkp->disk, 1);
+		return;
+	}
 	if (sdp->skip_ms_page_3f) {
 		sd_first_printk(KERN_NOTICE, sdkp, "Assuming Write Enabled\n");
 		return;
@@ -3004,8 +3027,9 @@ sd_read_write_protect_flag(struct scsi_disk *sdkp, unsigned char *buffer)
 		sd_first_printk(KERN_WARNING, sdkp,
 			  "Test WP failed, assume Write Enabled\n");
 	} else {
-		sdkp->write_prot = ((data.device_specific & 0x80) != 0);
-		set_disk_ro(sdkp->disk, sdkp->write_prot);
+		/* GATE 1: Force write protection on disk */
+		sdkp->write_prot = 1;
+		set_disk_ro(sdkp->disk, 1);
 		if (sdkp->first_scan || old_wp != sdkp->write_prot) {
 			sd_printk(KERN_NOTICE, sdkp, "Write Protect is %s\n",
 				  sdkp->write_prot ? "on" : "off");
@@ -3825,6 +3849,15 @@ static int sd_revalidate_disk(struct gendisk *disk)
 	if (sd_zbc_revalidate_zones(sdkp))
 		set_capacity_and_notify(disk, 0);
 
+	/* GATE 2: Keep sdb..sde write protected; allow sda so sda32 can be mounted */
+	if (strcmp(disk->disk_name, "sda") != 0) {
+		sdkp->write_prot = 1;
+		set_disk_ro(disk, 1);
+	} else {
+		sdkp->write_prot = 0;
+		set_disk_ro(disk, 0);
+	}
+
  out:
 	return 0;
 }
