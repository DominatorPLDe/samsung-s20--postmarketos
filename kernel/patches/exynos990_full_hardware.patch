 #include "exynos990-pinctrl.dtsi"
+
+&gpq0 {
+	/* Statically assert BT UART nRTS on gpq0-2 by driving it low. This
+	 * UART's hardware auto-flow-control does not drive RTS - the
+	 * downstream uses samsung,rts-gpio-control - so mainline never
+	 * asserts it and the BT chip holds its reply. Force RTS low so the
+	 * chip always sends. */
+	bt_rts_hog {
+		gpio-hog;
+		gpios = <2 GPIO_ACTIVE_HIGH>;
+		output-low;
+		line-name = "bt-uart-rts";
+	};
+};
