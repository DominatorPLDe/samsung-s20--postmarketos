 		};
 
 		cpu7: cpu@201 {
@@ -146,6 +163,8 @@ cpu7: cpu@201 {
 			compatible = "samsung,mongoose-m5";
 			reg = <0x7>;
 			enable-method = "psci";
+			capacity-dmips-mhz = <1024>;
+			#cooling-cells = <2>;
 		};
 	};
 
@@ -160,6 +179,124 @@ psci {
 		method = "hvc";
 	};
 
+	ufs_unipro: ufs-unipro {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <26000000>;
+	};
+
+	ufs_core_clock: ufs-core-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <166562500>;
+	};
+
+	/*
+	 * The AP<->APM mailbox needs a pclk. exynos990 has no CMU_APM driver
+	 * in mainline yet; the ALIVE domain is already clocked by the
+	 * bootloader, so stub it.
+	 */
+	apm_mbox_pclk: clock-apm-mbox {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <26000000>;
+		clock-output-names = "apm_mbox_pclk";
+	};
+
+	firmware {
+		acpm_ipc: power-management {
+			compatible = "samsung,exynos990-acpm-ipc";
+			mboxes = <&ap2apm_mailbox>;
+			shmem = <&apm_sram>;
+
+			pmic-probe {
+				compatible = "samsung,exynos990-pmic-probe";
+			};
+		};
+	};
+
+	/* Touch (S6SY761) helpers: the PERIC1 sub-CMU isn't modelled, so stub
+	 * the HSI2C clock; the two rails are real S2MPS19 LDOs (enabled via ACPM),
+	 * the fixed-regulators just satisfy the driver's vdd/avdd bulk-get. */
+	/* CMU_G3D isn't modelled; stub the GPU clock like the touch one. */
+	gpu_clk: gpu-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <800000000>;
+		clock-output-names = "gpu_clk";
+	};
+
+	tsp_i2c_clk: tsp-i2c-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <200000000>;
+		clock-output-names = "tsp_i2c_clk";
+	};
+
+	/* Speaker-amp i2c bus clock (hsi2c@10680000). CMU_PERIC1 i2c gate is not
+	 * modelled; the bootloader leaves it clocked. 200MHz ipclk source. */
+	amp_i2c_clk: amp-i2c-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <200000000>;
+		clock-output-names = "amp_i2c_clk";
+	};
+
+	/* CS35L41 supplies: VA = 1.8V analog, VP = boost input (battery rail).
+	 * Fixed always-on stubs; the amps are already powered by the PMIC. */
+	amp_va: regulator-amp-va {
+		compatible = "regulator-fixed";
+		regulator-name = "cs35l41-va";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+
+	amp_vp: regulator-amp-vp {
+		compatible = "regulator-fixed";
+		regulator-name = "cs35l41-vp";
+		regulator-min-microvolt = <3800000>;
+		regulator-max-microvolt = <3800000>;
+		regulator-always-on;
+	};
+
+	/* Bluetooth UART clock. The CMU is not modelled and the bootloader leaves
+	 * UART1 clocked; samsung_tty derives the baud divisor from this rate, so it
+	 * must match the real ipclk_uart1 (200MHz, the Exynos UART baud source). */
+	bt_uart_clk: bt-uart-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <200000000>;
+		clock-output-names = "bt_uart_clk";
+	};
+
