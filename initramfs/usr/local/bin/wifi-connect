#!/bin/sh
SSID="$1"
PASS="$2"

if [ -z "$SSID" ]; then
    echo "Verwendung: wifi-connect <SSID> [PASSWORT]"
    exit 1
fi

rfkill unblock all 2>/dev/null || true
ip link set wlan0 up 2>/dev/null || true

mkdir -p /etc/wpa_supplicant /var/run/wpa_supplicant

if [ -z "$PASS" ]; then
    cat << WEOF > /etc/wpa_supplicant/wpa_supplicant.conf
ctrl_interface=/var/run/wpa_supplicant
update_config=1

network={
    ssid="$SSID"
    key_mgmt=NONE
}
WEOF
else
    cat << WEOF > /etc/wpa_supplicant/wpa_supplicant.conf
ctrl_interface=/var/run/wpa_supplicant
update_config=1

network={
    ssid="$SSID"
    psk="$PASS"
}
WEOF
fi

chmod 600 /etc/wpa_supplicant/wpa_supplicant.conf

if [ -d /data ]; then
    cp /etc/wpa_supplicant/wpa_supplicant.conf /data/wpa_supplicant.conf
    echo "[+] Konfiguration dauerhaft in /data/wpa_supplicant.conf gespeichert."
fi

killall wpa_supplicant 2>/dev/null || true
sleep 1

echo "Verbinde mit '$SSID'..."
wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant/wpa_supplicant.conf 2>/dev/null || \
    wpa_supplicant -B -D nl80211,wext -i wlan0 -c /etc/wpa_supplicant/wpa_supplicant.conf 2>/dev/null

for i in $(seq 1 15); do
    if wpa_cli -i wlan0 status 2>/dev/null | grep -q "wpa_state=COMPLETED"; then
        echo "WLAN authentifiziert. Beziehe IP via DHCP..."
        killall udhcpc 2>/dev/null || true
        udhcpc -i wlan0 -b -q
        IP=$(ip -4 addr show wlan0 2>/dev/null | grep -o 'inet [0-9.]*' | cut -d' ' -f2)
        echo "=================================================="
        echo " ERFOLGREICH VERBUNDEN: '$SSID'"
        echo " WLAN-IP-Adresse: $IP"
        echo " SSH: ssh root@$IP"
        echo " Web-Dashboard: http://$IP"
        echo "=================================================="
        exit 0
    fi
    sleep 1
done

echo "[-] Verbindungs-Timeout. Status:"
wpa_cli -i wlan0 status 2>/dev/null || true
